{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursefind-data.local/schemas/bundle.schema.json",
  "title": "Flat programme bundle (one institution, one academic year)",
  "description": "The hand-typed input format. One file per institution-year; several are normally zipped together. scripts/convert_bundle.py converts this into the requirement trees in seeds/programme.schema.json. See docs/BUNDLE_FORMAT.md.",
  "type": "object",
  "required": [
    "institution",
    "academic_year",
    "programmes"
  ],
  "additionalProperties": false,
  "properties": {
    "institution": {
      "$ref": "#/$defs/institution"
    },
    "academic_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "programmes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/programme"
      }
    }
  },
  "$defs": {
    "institution": {
      "type": "object",
      "required": [
        "id",
        "name",
        "scoring_strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scoring_strategy": {
          "type": "string",
          "minLength": 1
        },
        "scoring_config": {
          "type": "object"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Where the numbers came from. document is the R2 key of the archived source PDF (see scripts/archive_source.py), so every record's source_doc resolves to a real document.",
      "required": [
        "document"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "An NSC achievement level, never a percentage."
    },
    "notAccepted": {
      "const": "not_accepted",
      "description": "The subject is EXCLUDED: a learner offering it is barred. Opposite of null/omitted, which means the subject is simply not mentioned. Use it only when the source says so -- 'Not applicable' is absence, not exclusion."
    },
    "languageBand": {
      "type": "object",
      "description": "A language required at one level as Home Language and another as First Additional Language.",
      "required": [
        "home_language",
        "first_additional_language"
      ],
      "additionalProperties": false,
      "properties": {
        "home_language": {
          "$ref": "#/$defs/level"
        },
        "first_additional_language": {
          "$ref": "#/$defs/level"
        }
      }
    },
    "requirementValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/level"
        },
        {
          "$ref": "#/$defs/notAccepted"
        },
        {
          "$ref": "#/$defs/languageBand"
        },
        {
          "type": "null"
        }
      ]
    },
    "anyOfBlock": {
      "type": "array",
      "minItems": 2,
      "description": "A manual OR: each item is a single-key {subject: level} object; the whole list becomes one `any` node. Use this only for alternatives that are NOT already a national subject-choice group (Mathematics/Mathematical Literacy/Technical Mathematics groups automatically -- see requirements' own description). Only one any_of block per programme is supported.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/level"
        },
        "propertyNames": {
          "enum": [
            "accounting",
            "afrikaans",
            "agricultural_sciences",
            "business_studies",
            "computer_applications_technology",
            "consumer_studies",
            "design",
            "dramatic_arts",
            "economics",
            "engineering_graphics_and_design",
            "english",
            "geography",
            "history",
            "hospitality_studies",
            "information_technology",
            "isindebele",
            "isixhosa",
            "isizulu",
            "life_orientation",
            "life_science",
            "life_sciences",
            "mathematical_literacy",
            "mathematics",
            "maths",
            "maths_literacy",
            "music",
            "physical_science",
            "physical_sciences",
            "religion_studies",
            "sepedi",
            "sesotho",
            "setswana",
            "siswati",
            "technical_mathematics",
            "technical_maths",
            "technical_science",
            "technical_sciences",
            "tourism",
            "tshivenda",
            "visual_arts",
            "xitsonga"
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "description": "One entry per subject column in the source table. Mathematics / Mathematical Literacy / Technical Mathematics group into an automatic OR whenever 2+ are present with real levels -- no special syntax needed. Any OTHER alternative (e.g. Physical Sciences OR Technical Sciences) needs an explicit any_of block. Language families are written as the family ('english'), not as _hl/_fal.",
      "properties": {
        "any_of": {
          "$ref": "#/$defs/anyOfBlock"
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "const": "any_of"
          },
          {
            "enum": [
              "accounting",
              "afrikaans",
              "agricultural_sciences",
              "business_studies",
              "computer_applications_technology",
              "consumer_studies",
              "design",
              "dramatic_arts",
              "economics",
              "engineering_graphics_and_design",
              "english",
              "geography",
              "history",
              "hospitality_studies",
              "information_technology",
              "isindebele",
              "isixhosa",
              "isizulu",
              "life_orientation",
              "life_science",
              "life_sciences",
              "mathematical_literacy",
              "mathematics",
              "maths",
              "maths_literacy",
              "music",
              "physical_science",
              "physical_sciences",
              "religion_studies",
              "sepedi",
              "sesotho",
              "setswana",
              "siswati",
              "technical_mathematics",
              "technical_maths",
              "technical_science",
              "technical_sciences",
              "tourism",
              "tshivenda",
              "visual_arts",
              "xitsonga",
              "additional_language"
            ]
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/requirementValue"
      }
    },
    "apsVariants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "A published APS that differs by which maths subject the learner offers, or (the with_english_rating_* form) by the English level achieved.",
      "properties": {
        "with_mathematics": {
          "$ref": "#/$defs/aps"
        },
        "with_technical_mathematics": {
          "$ref": "#/$defs/aps"
        },
        "with_mathematical_literacy": {
          "$ref": "#/$defs/aps"
        },
        "with_english_rating_5": {
          "$ref": "#/$defs/aps"
        },
        "with_english_rating_5_upper": {
          "$ref": "#/$defs/aps"
        },
        "with_english_rating_4": {
          "$ref": "#/$defs/aps"
        }
      }
    },
    "aps": {
      "type": "integer",
      "minimum": 15,
      "maximum": 45
    },
    "programme": {
      "type": "object",
      "required": [
        "qualification_code",
        "programme",
        "duration_years",
        "minimum_aps",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "qualification_code": {
          "type": "string",
          "minLength": 1
        },
        "programme": {
          "type": "string",
          "minLength": 1,
          "description": "The programme's title, e.g. 'BA (Communication Design)'."
        },
        "faculty": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualification_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The section heading the row sat under, e.g. 'Extended Degree (4 years)'. A value starting 'Extended' sets extended=true unless extended is given explicitly."
        },
        "extended": {
          "type": "boolean"
        },
        "duration_years": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Required, never guessed from the name: 'BEng' is 4 years and 'BEngTech' is 3, and neither says so."
        },
        "campus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "minimum_aps": {
          "oneOf": [
            {
              "$ref": "#/$defs/aps"
            },
            {
              "$ref": "#/$defs/apsVariants"
            }
          ]
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "excluded_subjects": {
          "type": "array",
          "description": "Exclusions stated in prose under the table rather than in a column. Merged with the ones derived from 'not_accepted' cells.",
          "items": {
            "enum": [
              "accounting",
              "agricultural_sciences",
              "business_studies",
              "computer_applications_technology",
              "consumer_studies",
              "design",
              "dramatic_arts",
              "economics",
              "engineering_graphics_and_design",
              "geography",
              "history",
              "hospitality_studies",
              "information_technology",
              "life_orientation",
              "life_sciences",
              "mathematical_literacy",
              "mathematics",
              "music",
              "physical_sciences",
              "religion_studies",
              "technical_mathematics",
              "technical_sciences",
              "tourism",
              "visual_arts"
            ]
          }
        },
        "selection_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "career_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "verified",
            "extracted",
            "flagged"
          ]
        },
        "scoring_override": {
          "type": [
            "object",
            "null"
          ],
          "description": "Merges over the institution's scoring_config for this one programme's score calculation -- same algorithm, different parameters (e.g. a faculty-specific subject_count). Omit unless this programme genuinely departs from its institution's default."
        },
        "scoring_strategy_override": {
          "type": [
            "string",
            "null"
          ],
          "description": "Replaces the institution's scoring_strategy outright for this one programme, when a faculty uses a different ALGORITHM entirely (see api/src/app/scoring.py's SCORERS), not just different parameters of the same one."
        },
        "scoreable": {
          "type": "boolean",
          "description": "false means no formula produces a trustworthy score for this programme at all -- e.g. a Composite Index that needs National Benchmark Test results this dataset never collects (docs/scoring/uct.md, wits.md). Such a programme is never scored, qualified, or near-miss -- /v1/qualify reports it separately, carrying only its selection_notes. Omit for the overwhelmingly common case of true."
        }
      }
    }
  }
}
